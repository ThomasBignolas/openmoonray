  <tool name="moonray_setup" label="Render Setup" icon="ROP_usdrender"><script scriptType="python"><![CDATA[import moonray_houdini
moonray_houdini.run('setup')]]></script></tool>
  <tool name="moonray_ipr" label="Start IPR" icon="BUTTONS_play"><script scriptType="python"><![CDATA[import moonray_houdini
moonray_houdini.run('ipr')]]></script></tool>
  <tool name="moonray_pause" label="Pause IPR" icon="BUTTONS_pause"><script scriptType="python"><![CDATA[import moonray_houdini
moonray_houdini.run('pause')]]></script></tool>
  <tool name="moonray_restart" label="Restart IPR" icon="BUTTONS_reload"><script scriptType="python"><![CDATA[import moonray_houdini
moonray_houdini.run('restart')]]></script></tool>
