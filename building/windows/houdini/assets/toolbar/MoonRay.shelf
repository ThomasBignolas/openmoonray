moonray_houdini.run('stop')]]></script></tool>
  <tool name="moonray_preview" label="Render to MPlay" icon="ROP_ifd"><script scriptType="python"><![CDATA[import moonray_houdini
moonray_houdini.run('render', True)]]></script></tool>
  <tool name="moonray_render" label="Render to Disk" icon="ROP_usdrender"><script scriptType="python"><![CDATA[import moonray_houdini
